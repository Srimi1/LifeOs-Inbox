{
  "name": "lifeos-inbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A triage-and-decision layer above your inboxes. It extracts the obligation hiding inside each signal and holds it until it is closed.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "eval": "node eval/run.ts",
    "eval:misses": "node eval/run.ts --misses",
    "auth": "node --env-file-if-exists=.env apps/worker/src/index.ts auth",
    "backfill": "node --env-file-if-exists=.env apps/worker/src/index.ts backfill",
    "poll": "node --env-file-if-exists=.env apps/worker/src/index.ts poll",
    "triage": "node --env-file-if-exists=.env apps/worker/src/index.ts triage",
    "status": "node --env-file-if-exists=.env apps/worker/src/index.ts status",
    "brief": "node --env-file-if-exists=.env apps/worker/src/index.ts brief",
    "brief:dry": "node --env-file-if-exists=.env apps/worker/src/index.ts brief --dry",
    "brief:demo": "node eval/brief.ts --html",
    "test": "node --test 'packages/**/*.test.ts'",
    "review": "node --env-file-if-exists=.env apps/worker/src/index.ts review",
    "correct": "node --env-file-if-exists=.env apps/worker/src/index.ts correct",
    "rules": "node --env-file-if-exists=.env apps/worker/src/index.ts rules",
    "accept": "node --env-file-if-exists=.env apps/worker/src/index.ts accept",
    "revoke": "node --env-file-if-exists=.env apps/worker/src/index.ts revoke",
    "demo:correction": "node eval/correction-demo.ts",
    "demo:money": "node eval/money.ts",
    "demo:canary": "node eval/money.ts --kill-savesage",
    "money": "node --env-file-if-exists=.env apps/worker/src/index.ts money",
    "paid": "node --env-file-if-exists=.env apps/worker/src/index.ts paid",
    "card": "node --env-file-if-exists=.env apps/worker/src/index.ts card",
    "loops": "node --env-file-if-exists=.env apps/worker/src/index.ts loops",
    "close": "node --env-file-if-exists=.env apps/worker/src/index.ts close",
    "track": "node --env-file-if-exists=.env apps/worker/src/index.ts track",
    "snooze": "node --env-file-if-exists=.env apps/worker/src/index.ts snooze",
    "demo:followup": "node eval/followup.ts",
    "radar": "node --env-file-if-exists=.env apps/worker/src/index.ts radar",
    "metrics": "node --env-file-if-exists=.env apps/worker/src/index.ts metrics",
    "quarantine": "node --env-file-if-exists=.env apps/worker/src/index.ts quarantine",
    "demo:radar": "node eval/radar.ts"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "zod": "^4.4.3"
  }
}

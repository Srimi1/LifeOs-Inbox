{
  "name": "lifeos-inbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A triage-and-decision layer above your inboxes. It extracts the obligation hiding inside each signal and holds it until it is closed.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "eval": "node eval/run.ts",
    "eval:misses": "node eval/run.ts --misses",
    "auth": "node --env-file-if-exists=.env apps/worker/src/index.ts auth",
    "backfill": "node --env-file-if-exists=.env apps/worker/src/index.ts backfill",
    "poll": "node --env-file-if-exists=.env apps/worker/src/index.ts poll",
    "triage": "node --env-file-if-exists=.env apps/worker/src/index.ts triage",
    "status": "node --env-file-if-exists=.env apps/worker/src/index.ts status",
    "brief": "node --env-file-if-exists=.env apps/worker/src/index.ts brief",
    "brief:dry": "node --env-file-if-exists=.env apps/worker/src/index.ts brief --dry",
    "brief:demo": "node eval/brief.ts --html"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5"
  }
}

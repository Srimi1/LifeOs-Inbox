# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Application type: Web application, redirect URI http://localhost:8787/oauth/callback)
# See docs/week-1-setup.md for the full walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: daily brief delivery. Without a key the brief is written to
# data/outbox/ instead, so the pipeline still runs end to end.
RESEND_API_KEY=
BRIEF_TO=
BRIEF_FROM=LifeOS <onboarding@resend.dev>

# Optional: the model tier (week 3). Without a key the pipeline still runs —
# anything the rulepack cannot resolve stays honestly unresolved rather than
# being guessed at. ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, or `ant auth login`
# all work; the SDK resolves whichever is present.
ANTHROPIC_API_KEY=
# auto = use a recorded cassette, else call live and record
# replay = never touch the network (what CI runs)
# off = refuse model calls entirely
LIFEOS_MODEL_MODE=auto
